{{- /*
  惑星の一覧ページ（/illustration/ など5つ）を data/planets.yaml から作る（Hugo の content adapter）
  docs/spec.md 第3章・第6.1節

  作品が足りない惑星の扱い（_partials/planets.html と同じ規則）：
  - 本番：作品数が config.toml の min_works 未満の惑星は、ページを作らない
  - 確認用URL（本番以外）：すべて作る（ページ内に「準備中」と出す）

  ここではまだ作品ページの一覧が使えないため、content/works の各フォルダの index.md の Front Matter を直接読んで数える。
  二次創作（fanart）は /fanart/ の節（content/fanart/）で別に扱うので、ここでは作らない。
*/ -}}
{{- $min := site.Params.min_works | default 1 -}}
{{- $counts := dict -}}
{{- range os.ReadDir "content/works" -}}
  {{- if .IsDir -}}
    {{- $file := printf "content/works/%s/index.md" .Name -}}
    {{- if fileExists $file -}}
      {{- $parts := split (readFile $file) "---" -}}
      {{- if ge (len $parts) 3 -}}
        {{- $fm := index $parts 1 | transform.Unmarshal -}}
        {{- if not $fm.draft -}}
          {{- range $fm.planets -}}
            {{- $counts = merge $counts (dict . (add (index $counts . | default 0) 1)) -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range hugo.Data.planets -}}
  {{- if ne .id "fanart" -}}
    {{- $count := index $counts .id | default 0 -}}
    {{- $publish := or (ge $count $min) (not hugo.IsProduction) -}}
    {{- $render := cond $publish "always" "never" -}}
    {{- $.AddPage (dict
      "path" .id
      "kind" "page"
      "title" .name
      "layout" "planet"
      "params" (dict "planet" .id "color" .color "band" .band "name_en" .name_en "description" .intro)
      "build" (dict "render" $render "list" $render)
    ) -}}
  {{- end -}}
{{- end -}}
